<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night"
    android:layoutDirection="rtl">

    <ma.salam.alaikum.StarsView
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <View
            android:id="@+id/div1"
            android:layout_width="130dp"
            android:layout_height="2dp"
            android:background="@drawable/divider" />

        <TextView
            android:id="@+id/salam"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/salam"
            android:textColor="@color/gold"
            android:textSize="58sp" />

        <TextView
            android:id="@+id/salam_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:alpha="0.95"
            android:text="@string/salam_sub"
            android:textColor="@color/ivory"
            android:textSize="22sp" />

        <View
            android:id="@+id/div2"
            android:layout_width="130dp"
            android:layout_height="2dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/divider" />

        <TextView
            android:id="@+id/reply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="@drawable/reply_chip"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp"
            android:text="@string/salam_reply"
            android:textColor="@color/gold_soft"
            android:textSize="19sp"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:alpha="0"
            android:letterSpacing="0.06"
            android:text="@string/hint"
            android:textColor="@color/hint"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
